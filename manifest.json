{
  "manifest_version": 3,
  "name": "MultiSearch AI",
  "version": "1.0.0",
  "description": "Tick the AI sites you want, type a prompt (plus attachments), and send it to all of them at once. Switch tabs to compare answers.",
  "permissions": ["tabs", "tabGroups", "scripting", "storage", "favicon"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://claude.ai/*",
    "https://chat.deepseek.com/*",
    "https://grok.com/*",
    "https://www.perplexity.ai/*",
    "https://copilot.microsoft.com/*",
    "https://chat.mistral.ai/*"
  ],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MultiSearch AI",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" }
  }
}
