{
  "manifest_version": 3,
  "name": "AI MultiSearch",
  "version": "1.0.0",
  "description": "Ask once, get answers from multiple AI platforms. Injects prompts & attachments and easily switch between results.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "AI MultiSearch"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://chatgpt.com/*",
    "*://chat.openai.com/*",
    "*://gemini.google.com/*",
    "*://claude.ai/*",
    "*://chat.deepseek.com/*",
    "*://*.perplexity.ai/*",
    "*://chat.mistral.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://chat.openai.com/*",
        "*://gemini.google.com/*",
        "*://claude.ai/*",
        "*://chat.deepseek.com/*",
        "*://*.perplexity.ai/*",
        "*://chat.mistral.ai/*"
      ],
      "js": [
        "icons/platform-icons.js",
        "utils/platforms.js",
        "content/platform-adapters.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_end"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Open AI MultiSearch"
    },
    "switch-next-ai": {
      "suggested_key": {
        "default": "Alt+Right"
      },
      "description": "Cycle to Next AI Result"
    },
    "switch-prev-ai": {
      "suggested_key": {
        "default": "Alt+Left"
      },
      "description": "Cycle to Previous AI Result"
    }
  }
}

